def apply(theme):
    meta = load_toml(os.path.join(THEMES, theme, "theme.toml"))
    os.makedirs(STATE, exist_ok=True)
    relink(CURRENT, os.path.join(THEMES, theme))
    with open(os.path.join(STATE, "name"), "w") as f:
        f.write(theme + "\n")

    background = pick_background(theme, meta)
    if background:
        set_background(theme, background, meta)
    apply_hyprland()
    colours, _ = apply_hyprpanel(meta)
    apply_wayle(theme, colours)
    network_icons(colours)
    apply_gtk4(theme, meta)
    apply_color_scheme(theme)
    apply_obsidian(theme)
    apply_claude(theme)
    apply_firefox(theme)
    apply_icons(theme)
    apply_nautilus()
    apply_starship()
    apply_fish(theme, meta)
    apply_tmux()
    signal_apps()
    if not background:
        run("notify-send", "-a", "Theme", "Theme",
            f"No wallpapers for {meta['name']}: run theme-install-backgrounds")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args[0] == "--list":
        cur = current_theme()
        for t in themes():
            print(("* " if t == cur else "  ") + t)
        return 0

    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args[0] == "--background" and len(args) == 2:
            theme = current_theme()
            meta = load_toml(os.path.join(THEMES, theme, "theme.toml"))
            set_background(theme, os.path.abspath(os.path.expanduser(args[1])), meta)
            return 0
        if args[0] == "--reapply":
            apply(current_theme() or "default")
            return 0
        theme = args[0]
        if theme not in themes():
            print(f"unknown theme: {theme} (have: {', '.join(themes())})", file=sys.stderr)
            return 1
        apply(theme)
    return 0


if __name__ == "__main__":
    sys.exit(main())
