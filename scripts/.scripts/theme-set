    with open(os.path.join(STATE, "starship.toml"), "w") as f:
        f.write(base.rstrip("\n") + "\n\n" + palette)


def apply_fish(theme, meta):
    """Pick the fish theme; running shells reload via an --on-variable handler."""
    name = meta.get("fish", "")
    if name == "generate":
        os.makedirs(FISH_THEMES, exist_ok=True)
        with open(os.path.join(THEMES, theme, "fish.theme")) as f:
            text = f.read()
        with open(os.path.join(FISH_THEMES, "theme-switcher.theme"), "w") as f:
            f.write(text)
        name = "theme-switcher"
    def quote(text):  # fish single quotes: only \\ and \' are special
        return "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"
    script = (f"set -U __theme_fish {quote(name)}; "
              f"set -U __theme_bat {quote(meta.get('bat', ''))}; "
              f"set -U __theme_generation {time.time_ns()}")
    # Plain `fish -c`: with --no-config, fish doesn't save universal variables.
    run("fish", "-c", script)


def apply_tmux():
