#!/usr/bin/env python3
"""Switch the desktop theme, like Omarchy's omarchy-theme-set.

Usage:
    theme-set THEME            switch to a theme in ~/.config/themes
    theme-set --background IMG set the current theme's wallpaper (remembered per theme)
    theme-set --reapply        re-apply the current theme (e.g. at login)
    theme-set --list           list themes ("*" marks the current one)

State lives in ~/.local/state/theme/: `current` links to the theme's folder
and `background` to its wallpaper; apps read their colours through these:
    Hyprland borders  ~/.config/hypr/hyprland.lua  (dofile current/hyprland.lua)
    lock screen       ~/.config/hypr/hyprlock.conf (source current/hyprlock.conf)
    wallpaper         hyprpaper, via `background`
    kitty             include current/kitty.conf
    tmux              source-file current/tmux.conf
    rofi              @import current/rofi.rasi
    Neovim            lua/plugins/colorscheme.lua reads current/nvim.lua
    fish, starship    ~/.config/fish/config.fish (universal variables)
    Nautilus (GTK4)   ~/.config/gtk-4.0/gtk.css (restarted, windows reopened)
    folder icons      a Caticons-<theme> icon theme from icons.json
    light/dark        gsettings color-scheme, from colors.toml's mode
    Obsidian          a CSS snippet in each vault, from obsidian.css
    Claude Code       custom theme ~/.claude/themes/desktop.json, from claude.json
    Firefox nightTab  the profile's userContent.css, from nighttab.css (next start)
    HyprPanel         theme colours merged into ~/.config/hyprpanel/config.json
Running apps are told to reload; everything else picks it up on next start.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import tomllib
import urllib.parse

HOME = os.path.expanduser("~")
THEMES = os.path.join(HOME, ".config/themes")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "theme")
CURRENT = os.path.join(STATE, "current")
BACKGROUND = os.path.join(STATE, "background")
LOCK_BACKGROUND = os.path.join(STATE, "lock-background")
CHOSEN_BACKGROUNDS = os.path.join(STATE, "backgrounds.json")
HYPRPANEL_CONFIG = os.path.join(HOME, ".config/hyprpanel/config.json")
HYPRPANEL_THEMES = "/usr/share/hyprpanel/themes"
ICONS = os.path.join(HOME, ".local/share/icons/hicolor/scalable/apps")
CATICONS = os.path.join(HOME, ".icons/Caticons/symbolic/status")
GTK4 = os.path.join(HOME, ".config/gtk-4.0")
STARSHIP_BASE = os.path.join(HOME, ".config/starship.toml")
FISH_THEMES = os.path.join(HOME, ".config/fish/themes")
IMAGE_EXT = (".png", ".jpg", ".jpeg")

# HyprPanel network icons (see ~/.config/hyprpanel/modules.scss): state -> Caticons icon
NETWORK_ICONS = {
    "wired": "network-wired-symbolic",
    "wireless-0": "network-wireless-signal-none-symbolic",
    "wireless-1": "network-wireless-signal-weak-symbolic",
    "wireless-2": "network-wireless-signal-ok-symbolic",
    "wireless-3": "network-wireless-signal-good-symbolic",
    "wireless-4": "network-wireless-signal-excellent-symbolic",
    "offline": "network-wireless-disconnected-symbolic",
}


def run(*cmd, **kw):
    """Run a command, ignoring failures (an app that isn't running is fine)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10, **kw)
    except (OSError, subprocess.TimeoutExpired):
        return None


def load_toml(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def themes():
    return sorted(d for d in os.listdir(THEMES)
                  if os.path.isfile(os.path.join(THEMES, d, "theme.toml")))


def current_theme():
    try:
        return os.path.basename(os.path.realpath(CURRENT))
    except OSError:
        return None


def relink(link, target):
    tmp = f"{link}.tmp{os.getpid()}"
    os.symlink(target, tmp)
    os.replace(tmp, link)


# --- wallpaper -------------------------------------------------------------

def backgrounds(meta):
    folder = os.path.expanduser(meta.get("backgrounds", ""))
    try:
        return sorted(os.path.join(folder, f) for f in os.listdir(folder)
                      if f.lower().endswith(IMAGE_EXT))
    except OSError:
        return []


def chosen_backgrounds():
    try:
        with open(CHOSEN_BACKGROUNDS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def pick_background(theme, meta):
    files = backgrounds(meta)
    chosen = chosen_backgrounds().get(theme)
    if chosen in files:
        return chosen
    default = meta.get("background")
    if default:
        path = os.path.join(os.path.expanduser(meta["backgrounds"]), default)
        if path in files:
            return path
    return files[0] if files else None


def set_background(theme, path, meta):
    chosen = chosen_backgrounds()
    chosen[theme] = path
    with open(CHOSEN_BACKGROUNDS, "w") as f:
        json.dump(chosen, f, indent=2)
    relink(BACKGROUND, path)
    # The lock screen uses the wallpaper unless the theme names its own.
    lock = os.path.expanduser(meta.get("lock_background", "")) or path
    relink(LOCK_BACKGROUND, lock)
    run("hyprctl", "hyprpaper", "wallpaper", f",{path},cover")


# --- apps --------------------------------------------------------------------

def apply_hyprland():
    path = os.path.join(CURRENT, "hyprland.lua")
    run("hyprctl", "eval", f'dofile("{path}")')


def hyprpanel_theme_keys():
    """Every colour key any HyprPanel theme sets (all but buttons.style)."""
    keys = set()
    for name in os.listdir(HYPRPANEL_THEMES):
        if name.endswith(".json"):
            with open(os.path.join(HYPRPANEL_THEMES, name)) as f:
                keys |= set(json.load(f))
    keys.discard("theme.bar.buttons.style")
    return keys


def hyprpanel_running():
    r = run("pgrep", "-f", "hyprpanel-app")
    return bool(r and r.returncode == 0)


def contrast(a, b):
    """WCAG contrast ratio of two #rrggbb colours (1 to 21)."""
    def luminance(colour):
        c = [int(colour.lstrip("#")[i:i + 2], 16) / 255 for i in (0, 2, 4)]
        c = [x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4 for x in c]
        return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    hi, lo = sorted((luminance(a), luminance(b)), reverse=True)
    return (hi + 0.05) / (lo + 0.05)


def hover_square(colours):
    """Hovering a workspace paints a square in the hover colour behind its icon
    and draws the icon in the highlighted-text colour (a dark one). Catppuccin's
    and Tokyo Night's hover colours are bright: a clear square. Dracula's,
    Gruvbox's, Rosé Pine's… are dark greys, often the workspace box's own colour:
    no square, the icon just darkens. Give those the active workspace's colour."""
    ws = "theme.bar.buttons.workspaces."
    hover, text, active = (colours.get(ws + k) for k in
                           ("hover", "numbered_active_highlighted_text_color", "active"))
    try:
        if hover and text and active and contrast(hover, text) < 4.5:
            colours[ws + "hover"] = active
    except ValueError:  # not #rrggbb
        pass


def apply_hyprpanel(meta):
    """Merge the HyprPanel theme's colours into config.json.

    Done with HyprPanel stopped, then restarted: when config.json changes under
    a running HyprPanel it re-applies every option, and re-applying
    `wallpaper.enable = false` makes it warn that swww is missing.
    """
    # theme.toml names one of HyprPanel's themes, or "generate" for the
    # hyprpanel.json theme-generate made from the theme's palette.
    if meta["hyprpanel"] == "generate":
        source = os.path.join(CURRENT, "hyprpanel.json")
    else:
        source = os.path.join(HYPRPANEL_THEMES, f"{meta['hyprpanel']}.json")
    with open(source) as f:
        colours = {k: v for k, v in json.load(f).items() if k != "theme.bar.buttons.style"}
    hover_square(colours)
    # theme.toml can override single HyprPanel colours, e.g. the weather module
    # colour, which the VPN IT button uses (modules.scss).
    colours.update(meta.get("hyprpanel_overrides", {}))
    with open(HYPRPANEL_CONFIG) as f:
        config = json.load(f)
    # HyprPanel's theme files don't all set the same keys: drop colours the new
    # theme doesn't set, so they fall back to HyprPanel's defaults instead of
    # keeping the previous theme's values.
    stale = [k for k in hyprpanel_theme_keys() if k in config and k not in colours]
    if not stale and all(config.get(k) == v for k, v in colours.items()):
        return colours, False
    for k in stale:
        del config[k]
    config.update(colours)
    was_running = hyprpanel_running()
    if was_running:
        run(os.path.join(HOME, ".scripts/hyprpanel-quit"))
        for _ in range(30):
            if not hyprpanel_running():
                break
            time.sleep(0.1)
    # Write in place: config.json is a symlink into the dotfiles repo.
    with open(HYPRPANEL_CONFIG, "w") as f:
        f.write(json.dumps(config, indent=2, ensure_ascii=False))
    if was_running:
        run("hyprctl", "eval", 'hl.dispatch(hl.dsp.exec_cmd("hyprpanel"))')
    return colours, was_running


def network_icons(colours):
    """Tinted copies of the Caticons network icons, named after the colour."""
    colour = colours.get("theme.bar.buttons.network.icon", "#cba6f7")
    os.makedirs(ICONS, exist_ok=True)
    for state, source in NETWORK_ICONS.items():
        target = os.path.join(ICONS, f"hyprpanel-network-{state}-{colour.lstrip('#')}.svg")
        if os.path.exists(target):
            continue
        with open(os.path.join(CATICONS, f"{source}.svg")) as f:
            svg = f.read()
        with open(target, "w") as f:
            f.write(re.sub(r"fill:#[0-9a-fA-F]{6}", f"fill:{colour}", svg))


WAYLE_THEME = os.path.join(HOME, ".config/wayle/theme.toml")
# HyprPanel button -> Wayle module, so the bar looks the same in Wayle.
WAYLE_MODULES = {
    "dashboard": "dashboard", "media": "media", "windowtitle": "window-title",
    "notifications": "notifications", "systray": "systray", "volume": "volume",
    "network": "network", "bluetooth": "bluetooth", "battery": "battery", "clock": "clock",
}


def apply_wayle(theme, colours):
    """Wayle's colours (~/.config/wayle/theme.toml, imported by its config.toml;
    it reloads live, no restart): its palette, from HyprPanel's menu colours
    (so dropdowns look like HyprPanel's menus) and colors.toml, and each bar
    button's colours from the HyprPanel theme (with theme.toml's overrides),
    so the bar looks like HyprPanel's. The palette's red/green/blue are the VPN
    buttons' colours (HyprPanel's cpu/netstat/weather, as in modules.scss);
    Wayle's config.toml uses them by name for its custom VPN modules."""
    if not os.path.isdir(os.path.dirname(WAYLE_THEME)):
        return
    try:
        palette = load_toml(os.path.join(THEMES, theme, "colors.toml"))
    except (OSError, ValueError):
        palette = {}
    c = lambda key, default=None: colours.get(f"theme.bar.{key}", default)  # noqa: E731
    pal = {
        "bg": c("menus.background", palette.get("background")),
        "surface": c("menus.cards", palette.get("lighter_background")),
        "elevated": palette.get("selection") or c("menus.cards"),
        "fg": c("menus.text", palette.get("foreground")),
        "fg-muted": palette.get("muted") or c("menus.dimtext"),
        "primary": palette.get("accent") or c("buttons.borderColor"),
        "red": c("buttons.modules.cpu.text", palette.get("red")),
        "yellow": palette.get("yellow"),
        "green": c("buttons.modules.netstat.text", palette.get("green")),
        "blue": c("buttons.modules.weather.text", palette.get("blue")),
    }
    lines = ["# Written by ~/.scripts/theme-set for the current theme. Don't edit.", "",
             "[styling.palette]"]
    lines += [f'{k} = "{v}"' for k, v in pal.items() if v]
    for hp, wayle in WAYLE_MODULES.items():
        b = lambda key: c(f"buttons.{hp}.{key}")  # noqa: E731
        values = {
            "icon-color": b("icon") or b("customIcon"),
            "label-color": b("text") or b("total"),
            "border-color": b("border"),
            "button-bg-color": b("background"),
        }
        lines += ["", f"[modules.{wayle}]"]
        lines += [f'{k} = "{v}"' for k, v in values.items() if v]
    ws = lambda key: c(f"buttons.workspaces.{key}")  # noqa: E731
    lines += ["", "[modules.hyprland-workspaces]"]
    for k, v in (("active-color", ws("active")), ("occupied-color", ws("occupied")),
                 ("empty-color", ws("available")), ("container-bg-color", ws("background")),
                 ("border-color", ws("border"))):
        if v:
            lines.append(f'{k} = "{v}"')
    text = "\n".join(lines) + "\n"
    try:
        with open(WAYLE_THEME) as f:
            if f.read() == text:
                return
    except OSError:
        pass
    # Whole file at once (Wayle reloads as soon as the directory changes).
    with open(WAYLE_THEME + ".tmp", "w") as f:
        f.write(text)
    os.replace(WAYLE_THEME + ".tmp", WAYLE_THEME)


def apply_gtk4(theme, meta):
    source = meta.get("gtk4", "")
    if source == "generate":
        files = {"gtk.css": os.path.join(THEMES, theme, "gtk.css"),
                 "gtk-dark.css": os.path.join(THEMES, theme, "gtk.css")}
    elif source:
        files = {name: os.path.join(source, name) for name in ("gtk.css", "gtk-dark.css", "assets")}
    else:
        return
    os.makedirs(GTK4, exist_ok=True)
    for name, target in files.items():
        if os.path.exists(target):
            relink(os.path.join(GTK4, name), target)


NAUTILUS_WAITER = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "theme-nautilus-waiter.pid")


def nautilus_pid():
    r = run("pgrep", "-x", "nautilus")
    return int(r.stdout.split()[0]) if r and r.returncode == 0 and r.stdout.split() else None


def nautilus_busy(pid):
    """Copying or moving files? (Quitting Nautilus would abort that.)"""
    def io():
        try:
            with open(f"/proc/{pid}/io") as f:
                v = dict(line.split(": ") for line in f.read().splitlines())
            return int(v["rchar"]) + int(v["wchar"])
        except (OSError, ValueError, KeyError):
            return 0
    before = io()
    time.sleep(0.7)
    return io() - before > 2_000_000


def nautilus_clients():
    clients = run("hyprctl", "clients", "-j")
    try:
        return [c for c in json.loads(clients.stdout) if c.get("class") == "org.gnome.Nautilus"]
    except (AttributeError, ValueError):
        return []


def folder_title(uri):
    """Nautilus's window title for a folder."""
    path = urllib.parse.unquote(urllib.parse.urlparse(uri).path).rstrip("/")
    return "Home" if path == HOME else os.path.basename(path) or "/"


def nautilus_windows():
    """[(folder URI, Hyprland workspace)] for each open Nautilus window."""
    r = run("gdbus", "call", "--session", "--dest", "org.gnome.Nautilus",
            "--object-path", "/org/freedesktop/FileManager1",
            "--method", "org.freedesktop.DBus.Properties.Get",
            "org.freedesktop.FileManager1", "OpenWindowsWithLocations")
    if not (r and r.returncode == 0):
        return []
    tabs = [re.findall(r"'([^']*)'", group)
            for group in re.findall(r"'/org/gnome/Nautilus/window/\d+': \[([^\]]*)\]", r.stdout)]
    hypr = nautilus_clients()

    windows = []
    for uris in tabs:
        if not uris:
            continue
        # The window's title is its current tab's folder: use it to find both.
        match = next(((u, c) for c in hypr for u in uris if c["title"] == folder_title(u)), None)
        uri, client = match if match else (uris[0], None)
        if client:
            hypr.remove(client)
        windows.append((uri, client["workspace"]["name"] if client else None))
    return windows


def open_nautilus_window(uri, workspace, known):
    """Open a Nautilus window on a folder, straight onto its workspace without
    going there (a temporary Hyprland rule: launch rules don't work here, the
    windows belong to Nautilus's own process, not the one launched). Returns
    once the window has appeared; known holds the addresses seen so far."""
    if workspace:
        run("hyprctl", "eval",
            '_G.theme_set_nautilus = hl.window_rule({ name = "theme-set-nautilus", '
            'match = { class = "^(org.gnome.Nautilus)$" }, '
            f'workspace = {json.dumps(workspace + " silent")} }})')
    try:
        subprocess.Popen(["nautilus", "--new-window", uri], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:
            time.sleep(0.15)
            new = {c["address"] for c in nautilus_clients()} - known
            if new:
                known.update(new)
                return
    finally:
        if workspace:
            run("hyprctl", "eval",
                "if _G.theme_set_nautilus then _G.theme_set_nautilus:set_enabled(false) end")


def restart_nautilus():
    """Quit Nautilus and reopen its windows (current folder of each) on their
    workspaces, so open windows come back in the new theme. One at a time, so
    each lands on its own workspace."""
    windows = nautilus_windows()
    run("nautilus", "-q")
    for _ in range(50):
        if not nautilus_pid():
            break
        time.sleep(0.1)
    known = {c["address"] for c in nautilus_clients()}
    for uri, workspace in windows:
        open_nautilus_window(uri, workspace, known)


def apply_nautilus():
    """GTK4 apps read gtk.css only at startup, and Nautilus keeps running in the
    background after its windows close: restart it (reopening its windows) so
    it uses the new colours. If it's copying files, wait until it's done."""
    pid = nautilus_pid()
    if not pid:
        return
    try:  # a waiter from a previous switch is no longer needed
        with open(NAUTILUS_WAITER) as f:
            os.kill(int(f.read().strip()), 15)
    except (OSError, ValueError):
        pass
    if not nautilus_busy(pid):
        restart_nautilus()
        return
    waiter = subprocess.Popen(
        [sys.executable, "-c",
         "import importlib.machinery as m, importlib.util as u, sys, time\n"
         "l = m.SourceFileLoader('ts', sys.argv[1]); s = u.spec_from_loader('ts', l)\n"
         "ts = u.module_from_spec(s); l.exec_module(ts)\n"
         "while (pid := ts.nautilus_pid()) and ts.nautilus_busy(pid): time.sleep(5)\n"
         "ts.restart_nautilus() if pid else None\n",
         os.path.abspath(__file__)],
        start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    with open(NAUTILUS_WAITER, "w") as f:
        f.write(str(waiter.pid))


ICON_BASE = os.path.join(HOME, ".icons/Caticons")
USER_ICONS = os.path.join(HOME, ".local/share/icons")
GTK3_SETTINGS = os.path.join(HOME, ".config/gtk-3.0/settings.ini")


def recolour_png(data, mapping):
    """Recolour an embedded PNG (some Caticons folders have one): each pixel is
    shifted by the change of its nearest Catppuccin colour, keeping shading."""
    import base64
    import io
    from PIL import Image
    rgb = lambda c: tuple(int(c.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4))
    luma = lambda c: 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    pairs = [(rgb(k), rgb(v)) for k, v in mapping.items()]
    img = Image.open(io.BytesIO(base64.b64decode(data))).convert("RGBA")
    cache = {}
    pixels = []
    for r, g, b, a in img.get_flattened_data() if hasattr(img, "get_flattened_data") else img.getdata():
        if a == 0:
            pixels.append((r, g, b, a))
            continue
        key = (r, g, b)
        if key not in cache:
            src, dst = min(pairs, key=lambda p: sum((x - y) ** 2 for x, y in zip(p[0], key)))
            # The target colour, as bright or dark as the pixel is next to the
            # Catppuccin colour it's closest to (keeps gradients and shading).
            ratio = luma(key) / luma(src) if luma(src) else 0
            cache[key] = tuple(max(0, min(255, round(d * ratio))) for d in dst)
        pixels.append(cache[key] + (a,))
    img.putdata(pixels)
    out = io.BytesIO()
    img.save(out, "PNG")
    return base64.b64encode(out.getvalue()).decode()


def build_icon_theme(name, mapping):
    """Caticons-<theme>: Caticons' folder ("places") icons recoloured with the
    theme's icons.json; everything else falls back to Caticons."""
    target = os.path.join(USER_ICONS, name)
    stamp = hashlib.sha1(json.dumps(mapping, sort_keys=True).encode()).hexdigest()
    try:
        with open(os.path.join(target, ".stamp")) as f:
            if f.read() == stamp:
                return
    except OSError:
        pass
    shutil.rmtree(target, ignore_errors=True)
    with open(os.path.join(ICON_BASE, "index.theme")) as f:
        base = f.read()
    sections = dict(re.findall(r"(?ms)^\[([^\]]+)\]\n(.*?)(?=^\[|\Z)", base))
    dirs = [d for d in sections if d.endswith("/places")]
    pattern = re.compile("|".join(re.escape(c) for c in mapping), re.IGNORECASE)
    for d in dirs:
        src, dst = os.path.join(ICON_BASE, d), os.path.join(target, d)
        os.makedirs(dst, exist_ok=True)
        for entry in os.scandir(src):
            out = os.path.join(dst, entry.name)
            if entry.is_symlink():
                os.symlink(os.readlink(entry.path), out)
            elif entry.name.endswith(".svg"):
                with open(entry.path) as f:
                    svg = f.read()
                svg = pattern.sub(lambda m: mapping[m.group(0).lower()], svg)
                svg = re.sub(r"(data:image/png;base64,)([A-Za-z0-9+/=]+)",
                             lambda m: m.group(1) + recolour_png(m.group(2), mapping), svg)
                with open(out, "w") as f:
                    f.write(svg)
    index = [f"[Icon Theme]\nName={name}\nComment=Caticons with theme-coloured folders (theme-set)\n"
             f"Inherits=Caticons\nDirectories={','.join(dirs)}\n"]
    index += [f"[{d}]\n{sections[d].strip()}\n" for d in dirs]
    with open(os.path.join(target, "index.theme"), "w") as f:
        f.write("\n".join(index))
    with open(os.path.join(target, ".stamp"), "w") as f:
        f.write(stamp)


def apply_icons(theme):
    """Folder icons in the theme's colours. GTK apps (Nautilus included)
    switch icon themes live."""
    name = "Caticons"
    try:
        with open(os.path.join(THEMES, theme, "icons.json")) as f:
            mapping = {k.lower(): v for k, v in json.load(f).items()}
        name = f"Caticons-{theme}"
        build_icon_theme(name, mapping)
    except FileNotFoundError:
        pass
    run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", name)
    try:
        with open(GTK3_SETTINGS) as f:
            ini = f.read()
        new = re.sub(r"(?m)^gtk-icon-theme-name=.*$", f"gtk-icon-theme-name={name}", ini)
        if new != ini:
            with open(GTK3_SETTINGS, "w") as f:
                f.write(new)
    except OSError:
        pass


def apply_color_scheme(theme):
    """Light or dark, from colors.toml's mode: libadwaita apps, the portal
    (browsers' prefers-color-scheme) and GTK3's dark-theme preference. The
    GTK3 theme itself (Catppuccin Mocha) has no light variant installed."""
    mode = load_toml(os.path.join(THEMES, theme, "colors.toml")).get("mode", "dark")
    light = mode == "light"
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
        "prefer-light" if light else "prefer-dark")
    try:
        with open(GTK3_SETTINGS) as f:
            ini = f.read()
        new = re.sub(r"(?m)^gtk-application-prefer-dark-theme=.*$",
                     f"gtk-application-prefer-dark-theme={0 if light else 1}", ini)
        if new != ini:
            with open(GTK3_SETTINGS, "w") as f:
                f.write(new)
    except OSError:
        pass


OBSIDIAN_CONFIGS = [os.path.join(HOME, ".config/obsidian/obsidian.json"),
                    os.path.join(HOME, ".var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json")]
OBSIDIAN_SNIPPET = "desktop-theme"


def obsidian_vaults():
    vaults = []
    for config in OBSIDIAN_CONFIGS:
        try:
            with open(config) as f:
                vaults += [v["path"] for v in json.load(f).get("vaults", {}).values()]
        except (OSError, ValueError, KeyError):
            pass
    return [v for v in vaults if os.path.isdir(os.path.join(v, ".obsidian"))]


def apply_obsidian(theme):
    """Each Obsidian vault gets the theme's obsidian.css as the CSS snippet
    "desktop-theme" (it recolours Obsidian's Catppuccin theme; Obsidian reloads
    snippets when they change). A theme without one (Catppuccin, Default)
    leaves the Catppuccin theme as it is. The first run also enables the
    snippet and sets the base colour scheme to follow the system (light for
    Snow), and, for a vault in git, keeps the snippet out of it (it's
    per-machine)."""
    try:
        with open(os.path.join(THEMES, theme, "obsidian.css")) as f:
            css = f.read()
    except FileNotFoundError:
        css = "/* theme-set: this theme leaves Obsidian's theme as it is. */\n"
    for vault in obsidian_vaults():
        config = os.path.join(vault, ".obsidian")
        snippets = os.path.join(config, "snippets")
        os.makedirs(snippets, exist_ok=True)
        path = os.path.join(snippets, OBSIDIAN_SNIPPET + ".css")
        try:
            with open(path) as f:
                same = f.read() == css
        except OSError:
            same = False
        if not same:
            with open(path, "w") as f:
                f.write(css)

        appearance_path = os.path.join(config, "appearance.json")
        try:
            with open(appearance_path) as f:
                appearance = json.load(f)
        except (OSError, ValueError):
            appearance = {}
        changed = dict(appearance)
        enabled = changed.get("enabledCssSnippets", [])
        if OBSIDIAN_SNIPPET not in enabled:
            changed["enabledCssSnippets"] = enabled + [OBSIDIAN_SNIPPET]
        changed["theme"] = "system"
        if changed != appearance:
            with open(appearance_path, "w") as f:
                json.dump(changed, f, indent=2)

        exclude = os.path.join(vault, ".git/info/exclude")
        line = f"/.obsidian/snippets/{OBSIDIAN_SNIPPET}.css"
        if os.path.isdir(os.path.dirname(exclude)):
            try:
                with open(exclude) as f:
                    present = line in f.read().splitlines()
            except OSError:
                present = False
            if not present:
                with open(exclude, "a") as f:
                    f.write(f"# Written by theme-set (dotfiles), per machine.\n{line}\n")


CLAUDE_THEME = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude")),
                            "themes", "desktop.json")


def apply_claude(theme):
    """Claude Code's custom theme "desktop" (select it once: /theme, or
    "theme": "custom:desktop" in ~/.claude/settings.json): the theme's
    claude.json, or Claude's own dark look for a theme without one (Default).
    Claude Code reloads ~/.claude/themes/ live."""
    try:
        with open(os.path.join(THEMES, theme, "claude.json")) as f:
            text = f.read()
    except FileNotFoundError:
        text = json.dumps({"name": "Desktop (Claude's own)", "base": "dark"}, indent=2) + "\n"
    os.makedirs(os.path.dirname(CLAUDE_THEME), exist_ok=True)
    tmp = CLAUDE_THEME + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, CLAUDE_THEME)


FIREFOX = os.path.join(HOME, ".mozilla/firefox")
NIGHTTAB_ID = "{47bf427e-c83d-457d-9b3d-3db4118574bd}"


def firefox_profiles():
    try:
        with open(os.path.join(FIREFOX, "profiles.ini")) as f:
            ini = f.read()
    except OSError:
        return []
    paths = []
    for section in re.split(r"(?m)^\[", ini):
        path = re.search(r"(?m)^Path=(.+)$", section)
        if path:
            relative = re.search(r"(?m)^IsRelative=1$", section)
            paths.append(os.path.join(FIREFOX, path[1]) if relative else path[1])
    return [p for p in paths if os.path.isfile(os.path.join(p, "prefs.js"))]


def apply_firefox(theme):
    """nightTab's new-tab page in the theme's colours (its nighttab.css), via
    each Firefox profile's chrome/userContent.css. Firefox reads that at
    startup, so the colours change the next time Firefox starts. The first
    run also turns on userContent.css in user.js."""
    try:
        with open(os.path.join(THEMES, theme, "nighttab.css")) as f:
            body = f.read()
    except FileNotFoundError:
        body = ""
    for profile in firefox_profiles():
        with open(os.path.join(profile, "prefs.js")) as f:
            uuids = re.search(r'user_pref\("extensions\.webextensions\.uuids", "(.*)"\);', f.read())
        try:
            uuid = json.loads(json.loads(f'"{uuids[1]}"')).get(NIGHTTAB_ID) if uuids else None
        except ValueError:
            uuid = None
        if uuid and body:
            vars_ = "\n".join("        " + line for line in body.splitlines() if not line.startswith("/*"))
            css = (f"/* theme-set ({theme}): nightTab in the theme's colours. */\n"
                   f'@-moz-document url-prefix("moz-extension://{uuid}/") {{\n'
                   f"    html {{\n{vars_}\n    }}\n}}\n")
        else:
            css = f"/* theme-set ({theme}): nothing to change. */\n"
        chrome = os.path.join(profile, "chrome")
        os.makedirs(chrome, exist_ok=True)
        with open(os.path.join(chrome, "desktop-theme.css"), "w") as f:
            f.write(css)

        content = os.path.join(chrome, "userContent.css")
        imp = '@import url("desktop-theme.css");'
        try:
            with open(content) as f:
                text = f.read()
        except FileNotFoundError:
            text = ""
        if imp not in text:  # @import has to come first
            with open(content, "w") as f:
                f.write(f"{imp}  /* theme-set */\n{text}")

        user_js = os.path.join(profile, "user.js")
        pref = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
        try:
            with open(user_js) as f:
                text = f.read()
        except FileNotFoundError:
            text = ""
        if pref not in text:
            with open(user_js, "a") as f:
                f.write(("\n" if text and not text.endswith("\n") else "")
                        + "// theme-set: read chrome/userContent.css (nightTab colours).\n" + pref + "\n")


def apply_starship():
    """~/.local/state/theme/starship.toml: your starship.toml with the theme's palette."""
    with open(STARSHIP_BASE) as f:
        base = f.read()
    with open(os.path.join(CURRENT, "starship.toml")) as f:
        palette = f.read()
