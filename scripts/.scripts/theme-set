        run("tmux", "source-file", os.path.join(HOME, ".tmux.conf"))


def signal_apps():
    # kitty: just the colours, over its remote-control sockets (kitty.conf), so
    # programs running in it don't redraw. Kitty instances without a socket
    # (opened before remote control was set up) get the old SIGUSR1 config
    # reload instead, until they're reopened.
    colours = os.path.join(CURRENT, "kitty.conf")
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    with_socket = set()
    for name in os.listdir(runtime):
        if name.startswith("kitty-") and name[6:].isdigit():
            r = run("kitty", "@", "--to", f"unix:{os.path.join(runtime, name)}",
                    "set-colors", "--all", "--configured", colours)
            if r and r.returncode == 0:
                with_socket.add(int(name[6:]))
    r = run("pgrep", "-x", "kitty")
    for pid in (int(p) for p in (r.stdout.split() if r else [])):
        if pid not in with_socket:
            try:
                os.kill(pid, signal.SIGUSR1)
            except OSError:
                pass
    run("pkill", "-USR1", "-x", "nvim")    # Neovim: see lua/plugins/colorscheme.lua
    # On-screen keyboard (wvkbd): colours are fixed at start, so if it's open,
    # close it and open it again (onScreenKeyboard.sh reads the theme). Started
    # by Hyprland, not as our child.
    def keyboard_open():
        r = run("pgrep", "-x", "wvkbd-mobintl")
        return bool(r and r.stdout.strip())
    if keyboard_open():
        run("pkill", "-x", "wvkbd-mobintl")
        for _ in range(20):
            if not keyboard_open():
                break
            time.sleep(0.05)
        run("hyprctl", "eval", 'hl.dispatch(hl.dsp.exec_cmd("sh ~/.scripts/onScreenKeyboard.sh"))')
    try:  # backdrop behind the bar (by pidfile: pkill -f would hit anything mentioning it)
        with open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "bar-backdrop.pid")) as f:
            os.kill(int(f.read().strip()), signal.SIGUSR1)
    except (OSError, ValueError):
        pass


