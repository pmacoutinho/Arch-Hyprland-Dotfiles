#!/usr/bin/env python3
"""The dashboard's Night Mode tile, where Wayle has its Idle Inhibit one.

Wayle's dashboard tiles are fixed, so its Idle Inhibit tile is restyled as
Night Mode (styles/index.scss: a sunset icon, the "Night Mode" label from
~/.scripts/wayle-nerd-icons) and this watcher gives it that job. When the tile
turns idle inhibition on (Wayle's D-Bus property Active), it is turned straight
back off, and night mode (~/.scripts/toggleHyprsunset.sh) toggled instead.
Wayle doesn't signal the property's changes, so it's read 4 times a second
(a D-Bus call, no process started). The tile shows night mode's state, not
Wayle's: toggleHyprsunset.sh writes it to styles/_night-mode.scss, which
index.scss reads.

A Hyprland config reload turns night mode off, so after one the state is
written again. Autostarted by hyprland.lua; one at a time; ends with Hyprland.
"""
import os
import signal
import socket
import subprocess
import threading

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

TOGGLE = os.path.expanduser("~/.scripts/toggleHyprsunset.sh")
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PIDFILE = os.path.join(RUN, "night-mode-tile.pid")
NAME, PATH, IFACE = "com.wayle.IdleInhibit1", "/com/wayle/IdleInhibit", "com.wayle.IdleInhibit1"


def run(*args):
    subprocess.Popen(["sh", TOGGLE, *args], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


POLL_MS = 250
pending = False  # a read not answered yet (never two: one click, one toggle)


def poll(bus):
    global pending
    if pending:
        return True
    pending = True
    bus.call(NAME, PATH, "org.freedesktop.DBus.Properties", "Get",
             GLib.Variant("(ss)", (IFACE, "Active")), GLib.VariantType("(v)"),
             Gio.DBusCallFlags.NO_AUTO_START, 1000, None, on_active, bus)
    return True


def on_active(bus, result, _data):
    global pending
    pending = False
    try:
        active = bus.call_finish(result).unpack()[0]
    except GLib.Error:  # Wayle not running
        return
    if active:
        bus.call(NAME, PATH, IFACE, "Disable", None, None,
                 Gio.DBusCallFlags.NONE, -1, None, None)
        run()


def hyprland_events(loop):
    """Hyprland's event socket: write the state again after a config reload
    (which drops the screen shader); quit when Hyprland is gone."""
    path = os.path.join(RUN, "hypr", os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
                        ".socket2.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(path)
            for line in s.makefile("r", errors="replace"):
                if line.startswith("configreloaded>>"):
                    GLib.timeout_add(500, run, "--sync")  # (returns None: once)
    except OSError:
        pass
    GLib.idle_add(loop.quit)


def main():
    # One watcher: replace an older one.
    try:
        with open(PIDFILE) as f:
            old = int(f.read())
        with open(f"/proc/{old}/cmdline", "rb") as f:
            if b"night-mode-tile" in f.read():
                os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    GLib.timeout_add(POLL_MS, poll, bus)
    threading.Thread(target=hyprland_events, args=(loop,), daemon=True).start()
    run("--sync")  # after a login, night mode is off whatever the file said
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(loop.quit))
    loop.run()


if __name__ == "__main__":
    main()
