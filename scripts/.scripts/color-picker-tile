#!/usr/bin/env python3
"""The dashboard's Color Picker tile, where Wayle has its Power Saver one.

As HyprPanel's dashboard had: pick a colour on screen (hyprpicker), copied to
the clipboard. Wayle's dashboard tiles are fixed, so its Power Saver tile is
restyled (styles/index.scss: an eyedropper, the "Color Picker" label from
~/.scripts/wayle-nerd-icons) and this watcher gives it that job, as
~/.scripts/night-mode-tile does for the Idle Inhibit one. When the tile
switches power-profiles-daemon to power-saver, the profile is put straight
back and the picker started instead. (So does picking "saver" in the battery
dropdown: power saver is unused here.)

The open dashboard would be in hyprpicker's frozen picture, so it's closed
first with an Escape key, from a virtual keyboard this watcher keeps
(/dev/uinput, python-evdev). Not by hiding and showing the bar: that makes
~/.scripts/bar-backdrop.py rebuild its strip, and it restarted the bar.

The notification is this watcher's, not hyprpicker's (--notify): that one
writes the code in the colour picked, unreadable when it's dark. Here it's
in the normal text colour, with the colour as the icon.

Autostarted by hyprland.lua; one at a time; ends with Hyprland.
"""
import os
import re
import shutil
import signal
import socket
import subprocess
import threading

try:
    from evdev import UInput, ecodes
except ImportError:
    UInput = None

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PIDFILE = os.path.join(RUN, "color-picker-tile.pid")
NAME = PATH_IFACE = "org.freedesktop.UPower.PowerProfiles"
PATH = "/org/freedesktop/UPower/PowerProfiles"
SAVER = "power-saver"
PICK = ["hyprpicker", "--autocopy", "--no-fancy"]  # (--quiet hides the colour too)
SWATCH = os.path.join(RUN, "color-picker-tile.png")
CLOSE_MS = 300  # Escape, then the dashboard gone from the screen

keyboard = None  # the virtual keyboard (None: no /dev/uinput)

previous = "balanced"  # the profile to put back


def set_profile(bus, profile):
    bus.call(NAME, PATH, "org.freedesktop.DBus.Properties", "Set",
             GLib.Variant("(ssv)", (PATH_IFACE, "ActiveProfile", GLib.Variant("s", profile))),
             None, Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, -1, None, None)


def on_profile(bus, profile, pick=True):
    global previous
    if profile != SAVER:
        previous = profile
        return
    set_profile(bus, previous)
    if pick:
        if keyboard:
            for value in (1, 0):  # press, release
                keyboard.write(ecodes.EV_KEY, ecodes.KEY_ESC, value)
                keyboard.syn()
        GLib.timeout_add(CLOSE_MS if keyboard else 0, start_picker)


def start_picker():
    if subprocess.run(["pidof", "hyprpicker"], stdout=subprocess.DEVNULL).returncode:
        threading.Thread(target=pick, daemon=True).start()
    return False


def pick():
    out = subprocess.run(PICK, capture_output=True, text=True).stdout
    found = re.findall(r"#[0-9A-Fa-f]{6}\b", out)
    if not found:  # cancelled (Escape)
        return
    color = found[-1].upper()
    try:
        write_swatch(color)
        icon = ["--icon", SWATCH]
    except Exception:  # (no pycairo: no swatch)
        icon = []
    subprocess.run(["notify-send", "--app-name=Color Picker", *icon, "Color copied",
                    f"Selected color: <b>{color}</b>"])


def write_swatch(color):
    """The colour as a rounded square, with a faint edge (seen on any
    background, even in its own colour)."""
    import cairo
    size, r = 64, 14
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    cr = cairo.Context(surface)
    cr.new_sub_path()
    for x, y, a in ((size - r, r, -90), (size - r, size - r, 0), (r, size - r, 90), (r, r, 180)):
        cr.arc(x, y, r - 1, a * 3.14159265 / 180, (a + 90) * 3.14159265 / 180)
    cr.close_path()
    rgb = [int(color[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    cr.set_source_rgb(*rgb)
    cr.fill_preserve()
    cr.set_source_rgba(0.5, 0.5, 0.5, 0.6)
    cr.set_line_width(2)
    cr.stroke()
    surface.write_to_png(SWATCH)


def on_changed(bus, _sender, _path, _iface, _signal, params, _data):
    iface, changed, _ = params.unpack()
    if iface == PATH_IFACE and "ActiveProfile" in changed:
        on_profile(bus, changed["ActiveProfile"])


def hyprland_events(loop):
    """Quit when Hyprland is gone (its event socket closes)."""
    path = os.path.join(RUN, "hypr", os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
                        ".socket2.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(path)
            while s.recv(65536):
                pass
    except OSError:
        pass
    GLib.idle_add(loop.quit)


def main():
    if not shutil.which("hyprpicker"):
        raise SystemExit("color-picker-tile: hyprpicker is not installed")
    # One watcher: replace an older one.
    try:
        with open(PIDFILE) as f:
            old = int(f.read())
        with open(f"/proc/{old}/cmdline", "rb") as f:
            if b"color-picker-tile" in f.read():
                os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    global keyboard
    if UInput:  # (without python-evdev, the dashboard stays in the picture)
        try:
            keyboard = UInput({ecodes.EV_KEY: [ecodes.KEY_ESC]}, name="color-picker-tile")
        except OSError:  # /dev/uinput not ours
            pass

    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    bus.signal_subscribe(NAME, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         PATH, None, Gio.DBusSignalFlags.NONE, on_changed, None)
    # Power saver left on from before: off (the tile would look switched on).
    try:
        current = bus.call_sync(NAME, PATH, "org.freedesktop.DBus.Properties", "Get",
                                GLib.Variant("(ss)", (PATH_IFACE, "ActiveProfile")),
                                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 2000, None)
        on_profile(bus, current.unpack()[0], pick=False)
    except GLib.Error:
        pass  # power-profiles-daemon not running: the tile does nothing
    threading.Thread(target=hyprland_events, args=(loop,), daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(loop.quit))
    loop.run()


if __name__ == "__main__":
    main()
