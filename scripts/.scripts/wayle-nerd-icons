def glyph_svg(cp):
    """1 em square SVG of the glyph for codepoint cp (from the Nerd Font, or
    whichever font fontconfig picks for it, as HyprPanel's text did)."""
    path = subprocess.run(["fc-match", "-f", "%{file}", f"{FONT}:charset={cp:x}"],
                          capture_output=True, text=True).stdout
    if path not in _fonts:
        _fonts[path] = TTFont(path)
    font = _fonts[path]
    name = font.getBestCmap().get(cp)
    if not name:
        raise SystemExit(f"no glyph for U+{cp:X} (is {FONT} installed?)")
    glyphs = font.getGlyphSet()
    em = font["head"].unitsPerEm
    bounds = BoundsPen(glyphs)
    glyphs[name].draw(bounds)
    x0, y0, x1, y1 = bounds.bounds
    pen = SVGPathPen(glyphs)
    glyphs[name].draw(pen)
    cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
    # Font units have y up; flip, and centre a 1 em view box on the glyph.
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" '
            f'viewBox="{cx - em / 2:g} {-cy - em / 2:g} {em} {em}">'
            f'<path fill="#000" transform="scale(1,-1)" d="{pen.getCommands()}"/></svg>\n')


def text_svg(text, font):
    """A square SVG (GTK draws icons square) as wide as the text's layout, the
    text along its top, and that width."""
    cr = cairo.Context(cairo.RecordingSurface(cairo.CONTENT_ALPHA, None))
    options = cairo.FontOptions()
    options.set_hint_style(cairo.HINT_STYLE_SLIGHT)
    options.set_hint_metrics(cairo.HINT_METRICS_OFF)
    context = PangoCairo.create_context(cr)
    PangoCairo.context_set_font_options(context, options)
    context.set_round_glyph_positions(False)
    layout = Pango.Layout.new(context)
    layout.set_font_description(Pango.FontDescription.from_string(font))
    layout.set_text(text, -1)
    width = layout.get_extents()[1].width / Pango.SCALE
    baseline = layout.get_baseline() / Pango.SCALE
    cr.translate(0, round(baseline) - baseline)
    PangoCairo.layout_path(cr, layout)
    cr.identity_matrix()
    d = ""
    for op, pts in cr.copy_path():
        d += {cairo.PATH_MOVE_TO: "M", cairo.PATH_LINE_TO: "L",
              cairo.PATH_CURVE_TO: "C"}.get(op, "Z") + " ".join(f"{v:.3f}" for v in pts)
    return width, (f'<svg xmlns="http://www.w3.org/2000/svg" width="{width:g}" '
                   f'height="{width:g}" viewBox="0 0 {width:g} {width:g}">'
                   f'<path fill="#000" d="{d}"/></svg>\n')


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def globs(match, classes):
    """HyprPanel matched classes case-insensitively anywhere in the name. The
    workspaces' patterns take [kK] classes; the window title's and media's
    don't, so those get the lower-case and Capitalised spellings."""
    kind, _, text = match.rpartition(":")
    prefix = kind + ":" if kind else ""
    if classes:
        return [prefix + "*" + "".join(f"[{c.lower()}{c.upper()}]" if c.isalpha() else c
                                       for c in text) + "*"]
    return list(dict.fromkeys(f"{prefix}*{t}*" for t in (text.lower(), text.capitalize())))


def window_title_template():
    """Jinja template (Wayle's window-title format) giving HyprPanel's label:
    the application's name from NAMES, cut at 50 characters + "..."."""
    names = json.dumps([list(n) for n in NAMES], ensure_ascii=False)
    return ('{%- if not app -%}Desktop{%- else -%}'
            '{%- set ns = namespace(n="") -%}{%- set c = app|lower -%}'
            '{%- for k, v in ' + names + ' -%}'
            '{%- if not ns.n and ((k[1:] == c) if k[:1] == "=" else (k in c)) -%}'
            '{%- set ns.n = v -%}{%- endif -%}{%- endfor -%}'
            '{%- set t = ns.n or (app[:1]|upper ~ app[1:]) -%}'
            '{{ t[:50] ~ "..." if t|length > 50 else t }}{%- endif -%}')


def main():
    icons = {name: cp for name, cp in MODULE_ICONS.items()}
    mapping = []
    for match, cp in APPS:
        if isinstance(cp, str):
            mapping.append((match, cp))
            continue
        name = f"app-{cp:x}"
        icons[name] = cp
        mapping.append((match, f"cm-nf-{name}-symbolic"))

    tmp = tempfile.mkdtemp()
    try:
        for name, cp in icons.items():
            with open(os.path.join(tmp, f"nf-{name}.svg"), "w") as f:
                f.write(glyph_svg(cp))
        subprocess.run(["wayle", "icons", "import", tmp], check=True,
                       stdout=subprocess.DEVNULL)
    finally:
        shutil.rmtree(tmp)

    lines = ["# Generated by ~/.scripts/wayle-nerd-icons: HyprPanel's application icons.", ""]
    for table, classes in (("modules.hyprland-workspaces.app-icon-map", True),
                           ("modules.window-title.icon-mappings", False),
                           ("modules.media.player-icons", False)):
        seen = set()
        entries = ""
        for match, icon in mapping:
            for pattern in globs(match, classes):
                if pattern not in seen:
                    seen.add(pattern)
                    entries += f'"{pattern}" = "{icon}"\n'
        lines += [f"[{table}]", entries]
    lines += ["[modules.window-title]", f"format = {json.dumps(window_title_template())}", ""]
    tmp_toml = TOML + ".tmp"
    with open(tmp_toml, "w") as f:
        f.write("\n".join(lines))
    os.replace(tmp_toml, TOML)
    print(f"{len(icons)} icons imported, {TOML} written")

    # Straight into Wayle's icons: its import would scale them to 16 px.
    os.makedirs(ICON_DIR, exist_ok=True)
    for name, (text, font) in TEXT_ICONS.items():
        width, svg = text_svg(text, font)
        with open(os.path.join(ICON_DIR, f"cm-{name}-symbolic.svg"), "w") as f:
            f.write(svg)
        print(f"cm-{name}-symbolic: {text!r}, {width:g} px wide")


if __name__ == "__main__":
    main()
