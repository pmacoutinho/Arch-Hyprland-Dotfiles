#!/bin/bash
# Run by hypridle after the laptop wakes up (after_sleep_cmd in hypridle.conf).

# GVfs's HTTP helper keeps connections open across the sleep. Ones that went
# through a VPN tunnel that is gone now never get an answer, and a request on
# one hangs until TCP gives up (~15 min). HyprPanel loads music cover art
# (Tidal's is https) that way and waits for it, so its whole bar froze: stuck
# clock, no VPN/network modules. GVfs starts a fresh helper when needed.
pkill -x gvfsd-http

# Sound: the cards are there, but WirePlumber has none of them on (only its
# "Dummy Output"). Seen when the desktop restarted around a sleep: it tried
# the cards while they were away and switched them off for good. A restart
# makes it look again. (In the background: the VPN part below waits.)
(
    sleep 3
    grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null || exit 0
    pactl list short sinks 2>/dev/null | grep -qv auto_null && exit 0
    systemctl --user restart wireplumber
) &

# Proton VPN goes down on suspend. Its kill switch / leak protection then sends
# every DNS lookup to ::1 (pvpnksintrf0, ipv6leakintrf0…), so nothing resolves
# until it reconnects — and its app often doesn't (seen: 4 min, nothing), the
# CLI never does. Without DNS the IT VPN can't find its server either, and
# gives up after a few minutes. So if we woke up in that state, reconnect
# Proton (same choice as last time: pt, fastest or a server).
blocked_dns() {
    resolvectl dns 2>/dev/null | awk '$3 ~ /^\((pvpn|ipv6leak)/ && / ::1( |$)/ {found = 1} END {exit !found}'
}
proton_up() {
    nmcli -t -f NAME,TYPE connection show --active | grep -q '^ProtonVPN .*:vpn$'
}

nm-online -q -t 60 || exit 0
sleep 8  # give a running Proton app the chance to reconnect by itself
if ! proton_up && blocked_dns; then
    choice=$(awk '{print $1; exit}' "${XDG_RUNTIME_DIR:-/tmp}/vpn-proton-choice" 2>/dev/null)
    # (vpn-proton-connect.sh closes the Proton app first.)
    ~/.scripts/vpn-notify.sh 'Proton VPN' 'Reconnecting after sleep' \
        ~/.scripts/vpn-proton-connect.sh "${choice:-pt}"
fi

# An IT VPN (OpenVPN 3) session still retrying: with DNS back, restart it now
# instead of waiting for its next attempt (or for it to give up).
blocked_dns && exit 0
openvpn3 sessions-list 2>/dev/null | awk '
    /Path:/ {path = $2}
    /Status:/ && !/Client connected/ && path {print path; path = ""}' |
while read -r path; do
    openvpn3 session-manage --session-path "$path" --restart >/dev/null 2>&1
done
