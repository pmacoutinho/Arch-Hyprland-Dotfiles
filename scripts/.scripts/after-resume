#!/bin/bash
# Run by hypridle after the laptop wakes up (after_sleep_cmd in hypridle.conf).

# GVfs's HTTP helper keeps connections open across the sleep. Ones that went
# through a VPN tunnel that is gone now never get an answer, and a request on
# one hangs until TCP gives up (~15 min). HyprPanel loads music cover art
# (Tidal's is https) that way and waits for it, so its whole bar froze: stuck
# clock, no VPN/network modules. GVfs starts a fresh helper when needed.
pkill -x gvfsd-http

# Screens that never come back: on 2026-11-19 a wake (the HDMI screen had
# been plugged in/out around the sleep) restored a display with a bad mode, and
# from then on the driver refused every frame Hyprland sent: a grey screen for
# 12 min, ~9000 "failed to commit" lines a second in Hyprland's log (which
# lives in RAM: 727 MB by then), until another sleep. Seen in the log, it's
# fixed like that other sleep did: screens off and on (a full mode set), then,
# if that wasn't enough, the external screens switched off and on again
# (reconnect_output in hyprland.lua; black for ~2 s).
HYPR_LOG="${XDG_RUNTIME_DIR:-/tmp}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/hyprland.log"
frames_failing() {
    [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && [ -f "$HYPR_LOG" ] || return 1
    local before after
    before=$(stat -c %s "$HYPR_LOG")
    sleep 1
    after=$(stat -c %s "$HYPR_LOG")
    # Over 100 KB a second, mostly frames refused (normal: a few lines).
    [ $((after - before)) -gt 100000 ] &&
        [ "$(tail -c 65536 "$HYPR_LOG" | grep -ac 'failed to commit.*PAGE_FLIP_EVENT')" -gt 300 ]
}
dpms() { hyprctl eval "hl.dispatch(hl.dsp.dpms({ action = \"$1\" }))" >/dev/null 2>&1; }
fix_screens() {
    frames_failing || return 0
    logger -t after-resume "screens not updating (frames refused): turning them off and on"
    dpms off
    sleep 1
    dpms on
    sleep 2
    frames_failing || return 0
    logger -t after-resume "still refused: reconnecting the external screens"
    hyprctl monitors all -j 2>/dev/null |
        python3 -c 'import json, sys; print("\n".join(m["name"] for m in json.load(sys.stdin) if not m["name"].startswith("eDP")))' |
        while read -r out; do
            hyprctl eval "reconnect_output(\"$out\")" >/dev/null 2>&1
        done
    sleep 3
    frames_failing &&
        notify-send --urgency=critical --app-name=Display "Screen not updating" \
            "Hyprland's frames are still refused after waking. Sleeping again usually fixes it."
}

# Screens, sound, then the bar (in the background: the VPN part below waits).
(
    sleep 2
    fix_screens
    sleep 1
    # Sound: the cards are there, but WirePlumber has none of them on (only
    # its "Dummy Output"). Seen when the desktop restarted around a sleep: it
    # tried the cards while they were away and switched them off for good. A
    # restart makes it look again.
    if grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null &&
        ! pactl list short sinks 2>/dev/null | grep -qv auto_null; then
        systemctl --user restart wireplumber
        sleep 2
    fi
    # The Wayle bar loses some of its drawn icons and letters across a sleep
    # (NVIDIA: blank VPN/Bluetooth/volume icons, even with GSK_RENDERER=ngl,
    # see hyprland.lua), and only a restart draws them again. After the sound
    # fix, so it starts with the right audio device. Only if it's the running
    # bar (~/.scripts/bar-switch). The old one can hang while stopping (seen
    # after a wake: it gave up its services but stayed, a second bar on screen
    # with its last popup frozen black), so it's ended for sure; and if no
    # Wayle is left, one is started.
    if old=$(pidof wayle); then
        timeout 20 wayle panel restart >/dev/null 2>&1
        sleep 3
        for p in $old; do kill "$p" 2>/dev/null; done
        sleep 2
        for p in $old; do kill -9 "$p" 2>/dev/null; done
        sleep 1
        pidof wayle >/dev/null || wayle panel start >/dev/null 2>&1
    fi
) &

# VPNs down with the sleep: reconnect them once the link is back
# (~/.scripts/vpn-recover, also run whenever Wi-Fi or wired reconnects).
exec ~/.scripts/vpn-recover
