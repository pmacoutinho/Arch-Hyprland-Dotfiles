cursor_text_color        {p['background']}

url_color                {p['accent']}

active_tab_foreground    {p['background']}
active_tab_background    {p['accent']}
inactive_tab_foreground  {p['dark_foreground']}
inactive_tab_background  {p['background']}

active_border_color      {p['accent']}
inactive_border_color    {p['selection']}

color0   {p['background']}
color1   {p['red']}
color2   {p['green']}
color3   {p['yellow']}
color4   {p['blue']}
color5   {p['magenta']}
color6   {p['cyan']}
color7   {p['foreground']}
color8   {p['muted']}
color9   {p['bright_red']}
color10  {p['bright_green']}
color11  {p['bright_yellow']}
color12  {p['bright_blue']}
color13  {p['bright_magenta']}
color14  {p['bright_cyan']}
color15  {p['bright_foreground']}
"""


def rofi(p, bar):
    """rofi in the colours of the theme's HyprPanel bar and menus: menu
    background and text, the bar buttons' outline colour for the border, the
    search underline and the selected item (with background-coloured text)."""
    colours = {
        "BG": bar["theme.bar.menus.background"],
        "BGA": bar["theme.bar.buttons.borderColor"],
        "FG": bar["theme.bar.menus.text"],
        "FGA": p["red"],
        "BDR": bar["theme.bar.buttons.borderColor"],
        "SEL": bar["theme.bar.menus.background"],
        "UGT": p["red"],
        "IMG": bar["theme.bar.menus.label"],
        "OFF": p["muted"],
        "ON": p["green"],
    }
    body = "\n".join(f"    {k + ':':<6} #{hexa(v)};" for k, v in colours.items())
    return f"/* {HEADER} */\n* {{\n{body}\n}}\n"


def starship(p):
    names = {"overlay": "selection", "love": "red", "gold": "yellow", "rose": "orange",
             "pine": "blue", "foam": "cyan", "iris": "magenta"}
    body = "\n".join(f"{k} = '{p[v]}'" for k, v in names.items())
    return f"# {HEADER}\n[palettes.theme]\n{body}\n"


def tmux(p):
    # The catppuccin tmux plugin's colour names, mapped from the palette.
    names = {
        "bg": "background", "fg": "foreground",
        "rosewater": "light_foreground", "flamingo": "orange", "pink": "magenta",
        "mauve": "magenta", "red": "red", "maroon": "red", "peach": "orange",
        "yellow": "yellow", "green": "green", "teal": "cyan", "sky": "cyan",
        "sapphire": "blue", "blue": "blue", "lavender": "accent",
        "subtext_1": "light_foreground", "subtext_0": "light_foreground",
        "overlay_2": "dark_foreground", "overlay_1": "dark_foreground", "overlay_0": "muted",
        "surface_2": "muted", "surface_1": "selection", "surface_0": "lighter_background",
        "mantle": "dark_background", "crust": "darker_background",
    }
    lines = [f"# {HEADER}", "# Colours for the catppuccin tmux plugin."]
    lines += [f'set -g @thm_{k} "{p[v]}"' for k, v in names.items()]
    return "\n".join(lines) + "\n"


def gtk4(p):
    # libadwaita named colours: Nautilus and other GTK4 apps pick these up.
    names = {
        "accent_color": "accent", "accent_bg_color": "accent", "accent_fg_color": "background",
        "window_bg_color": "background", "window_fg_color": "foreground",
        "view_bg_color": "dark_background", "view_fg_color": "foreground",
        "headerbar_bg_color": "dark_background", "headerbar_fg_color": "foreground",
        "headerbar_backdrop_color": "background",
        "sidebar_bg_color": "darker_background", "sidebar_fg_color": "foreground",
        "sidebar_backdrop_color": "darker_background",
        "secondary_sidebar_bg_color": "dark_background", "secondary_sidebar_fg_color": "foreground",
        "card_bg_color": "lighter_background", "card_fg_color": "foreground",
        "dialog_bg_color": "background", "dialog_fg_color": "foreground",
        "popover_bg_color": "dark_background", "popover_fg_color": "foreground",
        "thumbnail_bg_color": "lighter_background", "thumbnail_fg_color": "foreground",
        "destructive_color": "red", "destructive_bg_color": "red", "destructive_fg_color": "background",
        "success_color": "green", "success_bg_color": "green", "success_fg_color": "background",
        "warning_color": "yellow", "warning_bg_color": "yellow", "warning_fg_color": "background",
        "error_color": "red", "error_bg_color": "red", "error_fg_color": "background",
    }
    lines = [f"/* {HEADER} */"]
    lines += [f"@define-color {k} {p[v]};" for k, v in names.items()]
    return "\n".join(lines) + "\n"


def fish(p):
    h = {k: v.lstrip("#") for k, v in p.items() if isinstance(v, str) and v.startswith("#")}
    return f"""# {HEADER}
fish_color_normal {h['foreground']}
fish_color_command {h['magenta']}
fish_color_keyword {h['blue']}
fish_color_quote {h['yellow']}
fish_color_redirection {h['green']}
fish_color_end {h['light_foreground']}
fish_color_error {h['red']}
fish_color_param {h['cyan']}
fish_color_comment {h['dark_foreground']}
fish_color_selection --reverse
fish_color_operator {h['foreground']}
fish_color_escape {h['green']}
fish_color_autosuggestion {h['dark_foreground']}
fish_color_cwd {h['cyan']}
fish_color_user {h['yellow']}
fish_color_host {h['blue']}
fish_color_host_remote {h['magenta']}
fish_color_cancel {h['foreground']}
fish_color_search_match --background={h['selection']}
fish_color_valid_path
fish_pager_color_progress {h['cyan']}
fish_pager_color_background --background={h['lighter_background']}
fish_pager_color_prefix {h['blue']}
