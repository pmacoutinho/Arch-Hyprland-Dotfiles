fish_pager_color_selected_prefix {h['blue']}
fish_pager_color_selected_completion {h['foreground']}
fish_pager_color_selected_description {h['foreground']}
"""


def nvim(p, meta):
    # aether.nvim (Omarchy's palette colourscheme) gets the palette itself.
    keys = ["background", "dark_background", "darker_background", "lighter_background",
            "foreground", "dark_foreground", "light_foreground", "bright_foreground", "muted",
            "red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown",
            "bright_red", "bright_yellow", "bright_green", "bright_cyan", "bright_blue",
            "bright_magenta", "accent", "selection"]
    short = {"background": "bg", "dark_background": "dark_bg", "darker_background": "darker_bg",
             "lighter_background": "lighter_bg", "foreground": "fg", "dark_foreground": "dark_fg",
             "light_foreground": "light_fg", "bright_foreground": "bright_fg"}
    colors = "\n".join(f'        {short.get(k, k)} = "{p[k]}",' for k in keys)
    return f"""-- {HEADER}
return {{
    colorscheme = "{meta['nvim_colorscheme']}",
    lualine = "{meta.get('lualine', 'auto')}",
    -- Start screen logo colour.
    accent = "{p['accent']}",
    -- For aether.nvim (used when colorscheme = "aether").
    palette = {{
{colors}
        cursor = "{p['bright_foreground']}",
        selection_foreground = "{p['foreground']}",
        selection_background = "{p['selection']}",
    }},
}}
"""


# HyprPanel theme for palettes HyprPanel doesn't ship (theme.toml:
# hyprpanel = "generate"): its Catppuccin Mocha theme with every Catppuccin
# colour swapped for the palette role it plays.
HYPRPANEL_BASE = "/usr/share/hyprpanel/themes/catppuccin_mocha.json"
CATPPUCCIN_ROLES = {
    "#f5e0dc": "light_foreground",   # rosewater
    "#f2cdcd": "bright_red",         # flamingo
    "#f5c2e7": "bright_magenta",     # pink
    "#cba6f7": "magenta",            # mauve
    "#f38ba8": "red",
    "#eba0ac": "bright_red",         # maroon
    "#fab387": "orange",             # peach
    "#f9e2af": "bright_yellow",
    "#a6e3a1": "green",
    "#94e2d5": "cyan",               # teal
    "#89dceb": "bright_cyan",        # sky
    "#74c7ec": "bright_blue",        # sapphire
    "#89b4fa": "blue",
    "#b4befe": "accent",             # lavender
    "#cdd6f4": "foreground",         # text
    "#bac2de": "light_foreground",   # subtext1
    "#a6adc8": "light_foreground",   # subtext0
    "#9399b2": "dark_foreground",    # overlay2
    "#7f849c": "dark_foreground",    # overlay1
    "#6c7086": "muted",              # overlay0
    "#585b70": "muted",              # surface2
    "#45475a": "selection",          # surface1
    "#313244": "lighter_background", # surface0
    "#242438": "button",             # HyprPanel's button background
    "#1e1e2e": "background",         # base
    "#181825": "dark_background",    # mantle
    "#11111b": "darker_background",  # crust
}


CATPPUCCIN_NAMES = {
    "rosewater": "#f5e0dc", "flamingo": "#f2cdcd", "pink": "#f5c2e7", "mauve": "#cba6f7",
    "red": "#f38ba8", "maroon": "#eba0ac", "peach": "#fab387", "yellow": "#f9e2af",
    "green": "#a6e3a1", "teal": "#94e2d5", "sky": "#89dceb", "sapphire": "#74c7ec",
    "blue": "#89b4fa", "lavender": "#b4befe",
}


def catppuccin_roles(meta):
    """CATPPUCCIN_ROLES, with theme.toml's [hyprpanel_roles] overrides
    (Catppuccin colour name -> palette role), e.g. to limit the bar to a few
    colours."""
    roles = dict(CATPPUCCIN_ROLES)
    for name, role in meta.get("hyprpanel_roles", {}).items():
        roles[CATPPUCCIN_NAMES[name]] = role
    return roles


def rgb(c):
    c = c.lstrip("#")
    return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * t) for x, y in zip(rgb(a), rgb(b)))


def hyprpanel(p, table=CATPPUCCIN_ROLES):
    roles = dict(p, button=mix(p["background"], p["lighter_background"], 0.4))

    def recolour(value):
        value = value.lower()
        # HyprPanel's file has near-copies (#b4beff, #f38ba7…): use the closest.
        nearest = min(table, key=lambda c: sum((x - y) ** 2 for x, y in zip(rgb(c), rgb(value))))
        return roles[table[nearest]].lower()

    with open(HYPRPANEL_BASE) as f:
        base = json.load(f)
    return json.dumps({k: (v if k == "theme.bar.buttons.style" else recolour(v))
                       for k, v in base.items()}, indent=2) + "\n"


def icons(p, table=CATPPUCCIN_ROLES):
    """Catppuccin colour -> this palette, for recolouring the Caticons folder
    icons (theme-set builds a Caticons-<theme> icon theme from it)."""
    roles = dict(p, button=mix(p["background"], p["lighter_background"], 0.4))
    mapping = {c: roles[r].lower() for c, r in table.items() if r != "button"}
    if all(k == v for k, v in mapping.items()):
        return None  # a Catppuccin palette: Caticons already matches
    return json.dumps(mapping, indent=2) + "\n"


def generate(theme):
    folder = os.path.join(THEMES, theme)
    with open(os.path.join(folder, "theme.toml"), "rb") as f:
        meta = tomllib.load(f)
    if not meta.get("generate"):
        return False
    with open(os.path.join(folder, "colors.toml"), "rb") as f:
        p = tomllib.load(f)
    table = catppuccin_roles(meta)
    if meta.get("hyprpanel") == "generate":
        bar_json = hyprpanel(p, table)
        bar = json.loads(bar_json)
    else:
        with open(f"/usr/share/hyprpanel/themes/{meta['hyprpanel']}.json") as f:
            bar = json.load(f)
    files = {
        "hyprland.lua": hyprland(p), "hyprlock.conf": hyprlock(p), "kitty.conf": kitty(p),
        "rofi.rasi": rofi(p, bar), "starship.toml": starship(p), "tmux.conf": tmux(p),
        "nvim.lua": nvim(p, meta),
    }
    if meta.get("gtk4") == "generate":
        files["gtk.css"] = gtk4(p)
    if meta.get("fish") == "generate":
        files["fish.theme"] = fish(p)
    if meta.get("hyprpanel") == "generate":
        files["hyprpanel.json"] = bar_json
    icon_map = icons(p, table) if meta.get("icons", True) else None
    path = os.path.join(folder, "icons.json")
    if icon_map:
        files["icons.json"] = icon_map
    elif os.path.exists(path):
        os.remove(path)
    for name, text in files.items():
        with open(os.path.join(folder, name), "w") as f:
            f.write(text)
    return True


def main():
    themes = sys.argv[1:] or sorted(
        d for d in os.listdir(THEMES) if os.path.isfile(os.path.join(THEMES, d, "theme.toml")))
    for theme in themes:
        if generate(theme):
            print(f"generated {theme}")


if __name__ == "__main__":
    main()
