#!/usr/bin/env python3
"""Generate each app's colour file for the themes in ~/.config/themes.

For every theme whose theme.toml has `generate = true`, reads its colors.toml
(Omarchy's palette format) and writes, next to it:
    hyprland.lua  hyprlock.conf  kitty.conf  rofi.rasi  starship.toml
    tmux.conf     gtk.css        fish.theme  nvim.lua    hyprpanel.json
    icons.json    obsidian.css   claude.json   nighttab.css
The kitty and Hyprland mappings follow Omarchy's templates
(github.com/omacom/omarchy default/themed/*.tpl, MIT).

Usage: theme-generate [THEME…]   (default: all generated themes)
Run it after editing a theme's colors.toml, then `theme-set <theme>`.
"""
import json
import os
import sys
import tomllib

THEMES = os.path.expanduser("~/.config/themes")
HEADER = "Generated by ~/.scripts/theme-generate from colors.toml; edit that and rerun."


def hexa(c, alpha="ff"):
    return c.lstrip("#").lower() + alpha


def hyprland(p):
    return f"""-- {HEADER}
-- Window borders and the compositor background, applied by ~/.config/hypr/hyprland.lua.
hl.config({{
    general = {{
        col = {{
            active_border   = {{ colors = {{ "rgba({hexa(p['accent'])})", "rgba({hexa(p['selection'])})" }}, angle = 30 }},
            inactive_border = "rgba({hexa(p['lighter_background'])})",
        }},
    }},
    misc = {{ background_color = "rgba({hexa(p['background'])})" }},
}})
"""


def hyprlock(p):
    # Same variable names as the Rosé Pine file hyprlock.conf was written for.
    names = {
        "base": "background", "surface": "lighter_background", "overlay": "selection",
        "muted": "muted", "subtle": "light_foreground", "text": "foreground",
        "love": "red", "gold": "yellow", "rose": "orange", "pine": "green",
        "foam": "blue", "iris": "magenta", "highlightLow": "lighter_background",
        "highlightMed": "selection", "highlightHigh": "muted",
    }
    lines = [f"# {HEADER}"]
    lines += [f"${k:<14} = 0xff{p[v].lstrip('#').lower()}" for k, v in names.items()]
    return "\n".join(lines) + "\n"


def kitty(p):
    # ANSI black and white: background and foreground, swapped round for a
    # light theme so "black" text stays dark there.
    black, white, bright_white = p["background"], p["foreground"], p["bright_foreground"]
    if p.get("mode") == "light":
        black, white, bright_white = p["foreground"], p["darker_background"], p["dark_background"]
    return f"""# {HEADER}
foreground               {p['foreground']}
background               {p['background']}
selection_foreground     {p['foreground']}
selection_background     {p['selection']}

cursor                   {p['bright_foreground']}
cursor_text_color        {p['background']}

url_color                {p['accent']}

active_tab_foreground    {p['background']}
active_tab_background    {p['accent']}
inactive_tab_foreground  {p['dark_foreground']}
inactive_tab_background  {p['background']}

active_border_color      {p['accent']}
inactive_border_color    {p['selection']}

color0   {black}
color1   {p['red']}
color2   {p['green']}
color3   {p['yellow']}
color4   {p['blue']}
color5   {p['magenta']}
color6   {p['cyan']}
color7   {white}
color8   {p['muted']}
color9   {p['bright_red']}
color10  {p['bright_green']}
color11  {p['bright_yellow']}
color12  {p['bright_blue']}
color13  {p['bright_magenta']}
color14  {p['bright_cyan']}
color15  {bright_white}
"""


def rofi(p, bar, overrides=None):
    """rofi in the colours of the theme's HyprPanel bar and menus: menu
    background and text, the bar buttons' outline colour for the border, the
    search underline and the selected item (with background-coloured text).
    theme.toml's [rofi] table overrides any of these (e.g. BG = "#282a36")."""
    colours = {
        "BG": bar["theme.bar.menus.background"],
        "BGA": bar["theme.bar.buttons.borderColor"],
        "FG": bar["theme.bar.menus.text"],
        "FGA": p["red"],
        "BDR": bar["theme.bar.buttons.borderColor"],
        "SEL": bar["theme.bar.menus.background"],
        "UGT": p["red"],
        "IMG": bar["theme.bar.menus.label"],
        "OFF": p["muted"],
        "ON": p["green"],
    }
    colours.update(overrides or {})
    body = "\n".join(f"    {k + ':':<6} #{hexa(v)};" for k, v in colours.items())
    return f"/* {HEADER} */\n* {{\n{body}\n}}\n"


def starship(p):
    names = {"overlay": "selection", "love": "red", "gold": "yellow", "rose": "orange",
             "pine": "blue", "foam": "cyan", "iris": "magenta"}
    body = "\n".join(f"{k} = '{p[v]}'" for k, v in names.items())
    return f"# {HEADER}\n[palettes.theme]\n{body}\n"


def tmux(p):
    # The catppuccin tmux plugin's colour names, mapped from the palette.
    names = {
        "bg": "background", "fg": "foreground",
        "rosewater": "light_foreground", "flamingo": "orange", "pink": "magenta",
        "mauve": "magenta", "red": "red", "maroon": "red", "peach": "orange",
        "yellow": "yellow", "green": "green", "teal": "cyan", "sky": "cyan",
        "sapphire": "blue", "blue": "blue", "lavender": "accent",
        "subtext_1": "light_foreground", "subtext_0": "light_foreground",
        "overlay_2": "dark_foreground", "overlay_1": "dark_foreground", "overlay_0": "muted",
        "surface_2": "muted", "surface_1": "selection", "surface_0": "lighter_background",
        "mantle": "dark_background", "crust": "darker_background",
    }
    lines = [f"# {HEADER}", "# Colours for the catppuccin tmux plugin."]
    lines += [f'set -g @thm_{k} "{p[v]}"' for k, v in names.items()]
    return "\n".join(lines) + "\n"


def gtk4(p):
    # libadwaita named colours: Nautilus and other GTK4 apps pick these up.
    names = {
        "accent_color": "accent", "accent_bg_color": "accent", "accent_fg_color": "background",
        "window_bg_color": "background", "window_fg_color": "foreground",
        "view_bg_color": "dark_background", "view_fg_color": "foreground",
        "headerbar_bg_color": "dark_background", "headerbar_fg_color": "foreground",
        "headerbar_backdrop_color": "background",
        "sidebar_bg_color": "darker_background", "sidebar_fg_color": "foreground",
        "sidebar_backdrop_color": "darker_background",
        "secondary_sidebar_bg_color": "dark_background", "secondary_sidebar_fg_color": "foreground",
        "card_bg_color": "lighter_background", "card_fg_color": "foreground",
        "dialog_bg_color": "background", "dialog_fg_color": "foreground",
        "popover_bg_color": "dark_background", "popover_fg_color": "foreground",
        "thumbnail_bg_color": "lighter_background", "thumbnail_fg_color": "foreground",
        "destructive_color": "red", "destructive_bg_color": "red", "destructive_fg_color": "background",
        "success_color": "green", "success_bg_color": "green", "success_fg_color": "background",
        "warning_color": "yellow", "warning_bg_color": "yellow", "warning_fg_color": "background",
        "error_color": "red", "error_bg_color": "red", "error_fg_color": "background",
    }
    lines = [f"/* {HEADER} */"]
    lines += [f"@define-color {k} {p[v]};" for k, v in names.items()]
    return "\n".join(lines) + "\n"


def fish(p):
    h = {k: v.lstrip("#") for k, v in p.items() if isinstance(v, str) and v.startswith("#")}
    return f"""# {HEADER}
fish_color_normal {h['foreground']}
fish_color_command {h['magenta']}
fish_color_keyword {h['blue']}
fish_color_quote {h['yellow']}
fish_color_redirection {h['green']}
fish_color_end {h['light_foreground']}
fish_color_error {h['red']}
fish_color_param {h['cyan']}
fish_color_comment {h['dark_foreground']}
fish_color_selection --reverse
fish_color_operator {h['foreground']}
fish_color_escape {h['green']}
fish_color_autosuggestion {h['dark_foreground']}
fish_color_cwd {h['cyan']}
fish_color_user {h['yellow']}
fish_color_host {h['blue']}
fish_color_host_remote {h['magenta']}
fish_color_cancel {h['foreground']}
fish_color_search_match --background={h['selection']}
fish_color_valid_path
fish_pager_color_progress {h['cyan']}
fish_pager_color_background --background={h['lighter_background']}
fish_pager_color_prefix {h['blue']}
fish_pager_color_completion {h['light_foreground']}
fish_pager_color_description {h['dark_foreground']}
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background={h['selection']}
fish_pager_color_selected_prefix {h['blue']}
fish_pager_color_selected_completion {h['foreground']}
fish_pager_color_selected_description {h['foreground']}
"""


def nvim(p, meta):
    # aether.nvim (Omarchy's palette colourscheme) gets the palette itself.
    keys = ["background", "dark_background", "darker_background", "lighter_background",
            "foreground", "dark_foreground", "light_foreground", "bright_foreground", "muted",
            "red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown",
            "bright_red", "bright_yellow", "bright_green", "bright_cyan", "bright_blue",
            "bright_magenta", "accent", "selection"]
    short = {"background": "bg", "dark_background": "dark_bg", "darker_background": "darker_bg",
             "lighter_background": "lighter_bg", "foreground": "fg", "dark_foreground": "dark_fg",
             "light_foreground": "light_fg", "bright_foreground": "bright_fg"}
    colors = "\n".join(f'        {short.get(k, k)} = "{p[k]}",' for k in keys)
    return f"""-- {HEADER}
return {{
    colorscheme = "{meta['nvim_colorscheme']}",
    lualine = "{meta.get('lualine', 'auto')}",
    -- Start screen logo colour.
    accent = "{p['accent']}",
    -- For aether.nvim (used when colorscheme = "aether").
    palette = {{
{colors}
        cursor = "{p['bright_foreground']}",
        selection_foreground = "{p['foreground']}",
        selection_background = "{p['selection']}",
    }},
}}
"""


# HyprPanel theme for palettes HyprPanel doesn't ship (theme.toml:
# hyprpanel = "generate"): its Catppuccin Mocha theme with every Catppuccin
# colour swapped for the palette role it plays.
HYPRPANEL_BASE = "/usr/share/hyprpanel/themes/catppuccin_mocha.json"
CATPPUCCIN_ROLES = {
    "#f5e0dc": "light_foreground",   # rosewater
    "#f2cdcd": "bright_red",         # flamingo
    "#f5c2e7": "bright_magenta",     # pink
    "#cba6f7": "magenta",            # mauve
    "#f38ba8": "red",
    "#eba0ac": "bright_red",         # maroon
    "#fab387": "orange",             # peach
    "#f9e2af": "bright_yellow",
    "#a6e3a1": "green",
    "#94e2d5": "cyan",               # teal
    "#89dceb": "bright_cyan",        # sky
    "#74c7ec": "bright_blue",        # sapphire
    "#89b4fa": "blue",
    "#b4befe": "accent",             # lavender
    "#cdd6f4": "foreground",         # text
    "#bac2de": "light_foreground",   # subtext1
    "#a6adc8": "light_foreground",   # subtext0
    "#9399b2": "dark_foreground",    # overlay2
    "#7f849c": "dark_foreground",    # overlay1
    "#6c7086": "muted",              # overlay0
    "#585b70": "muted",              # surface2
    "#45475a": "selection",          # surface1
    "#313244": "lighter_background", # surface0
    "#242438": "button",             # HyprPanel's button background
    "#1e1e2e": "background",         # base
    "#181825": "dark_background",    # mantle
    "#11111b": "darker_background",  # crust
}


CATPPUCCIN_NAMES = {
    "rosewater": "#f5e0dc", "flamingo": "#f2cdcd", "pink": "#f5c2e7", "mauve": "#cba6f7",
    "red": "#f38ba8", "maroon": "#eba0ac", "peach": "#fab387", "yellow": "#f9e2af",
    "green": "#a6e3a1", "teal": "#94e2d5", "sky": "#89dceb", "sapphire": "#74c7ec",
    "blue": "#89b4fa", "lavender": "#b4befe",
}


def catppuccin_roles(meta):
    """CATPPUCCIN_ROLES, with theme.toml's [hyprpanel_roles] overrides
    (Catppuccin colour name -> palette role or "#rrggbb"), e.g. to limit the
    bar to a few colours."""
    roles = dict(CATPPUCCIN_ROLES)
    for name, role in meta.get("hyprpanel_roles", {}).items():
        roles[CATPPUCCIN_NAMES[name]] = role
    return roles


def role_colour(roles, role):
    """A palette role name, or a literal "#rrggbb"."""
    return role if role.startswith("#") else roles[role]


def rgb(c):
    c = c.lstrip("#")
    return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * t) for x, y in zip(rgb(a), rgb(b)))


def hyprpanel(p, table=CATPPUCCIN_ROLES):
    roles = dict(p, button=mix(p["background"], p["lighter_background"], 0.4))

    def recolour(value):
        value = value.lower()
        # HyprPanel's file has near-copies (#b4beff, #f38ba7…): use the closest.
        nearest = min(table, key=lambda c: sum((x - y) ** 2 for x, y in zip(rgb(c), rgb(value))))
        return role_colour(roles, table[nearest]).lower()

    with open(HYPRPANEL_BASE) as f:
        base = json.load(f)
    return json.dumps({k: (v if k == "theme.bar.buttons.style" else recolour(v))
                       for k, v in base.items()}, indent=2) + "\n"


def icons(p, table=CATPPUCCIN_ROLES):
    """Catppuccin colour -> this palette, for recolouring the Caticons folder
    icons (theme-set builds a Caticons-<theme> icon theme from it)."""
    roles = dict(p, button=mix(p["background"], p["lighter_background"], 0.4))
    mapping = {c: role_colour(roles, r).lower() for c, r in table.items() if r != "button"}
    if all(k == v for k, v in mapping.items()):
        return None  # a Catppuccin palette: Caticons already matches
    return json.dumps(mapping, indent=2) + "\n"


# Catppuccin Mocha's other colour names (accents are in CATPPUCCIN_NAMES).
CATPPUCCIN_BASE_NAMES = {
    "text": "#cdd6f4", "subtext1": "#bac2de", "subtext0": "#a6adc8", "overlay2": "#9399b2",
    "overlay1": "#7f849c", "overlay0": "#6c7086", "surface2": "#585b70", "surface1": "#45475a",
    "surface0": "#313244", "base": "#1e1e2e", "mantle": "#181825", "crust": "#11111b",
}


def obsidian(p):
    """A CSS snippet for Obsidian's Catppuccin theme (github.com/catppuccin/obsidian):
    its --ctp-* colours swapped for this palette, as for HyprPanel. theme-set
    copies it into each vault's .obsidian/snippets/."""
    names = dict(CATPPUCCIN_NAMES, **CATPPUCCIN_BASE_NAMES)
    lines = [f"/* {HEADER} */", "body.theme-dark.theme-dark,", "body.theme-light.theme-light {"]
    for name, mocha in names.items():
        colour = p[CATPPUCCIN_ROLES[mocha]]
        lines.append(f"    --ctp-{name}: {', '.join(map(str, rgb(colour)))};")
    for name, mocha in CATPPUCCIN_NAMES.items():
        lines.append(f"    --hex-{name}: {p[CATPPUCCIN_ROLES[mocha]]};")
    return "\n".join(lines + ["}"]) + "\n"


def claude(p, meta):
    """A Claude Code custom theme (code.claude.com/docs/en/terminal-config):
    its colour tokens from the palette, on the dark or light base. theme-set
    writes it to ~/.claude/themes/desktop.json, which Claude Code reloads live."""
    bg, fg = p["background"], p["foreground"]
    tint = lambda colour, t: mix(bg, colour, t)
    tokens = {
        "claude": p["accent"], "text": fg, "inverseText": bg,
        "inactive": mix(bg, fg, 0.55), "subtle": mix(bg, fg, 0.35),
        "suggestion": p["blue"], "permission": p["blue"], "remember": p["blue"],
        "success": p["green"], "error": p["red"], "warning": p["yellow"], "merged": p["magenta"],
        "promptBorder": mix(bg, fg, 0.35), "planMode": p["cyan"], "autoAccept": p["magenta"],
        "bashBorder": p["magenta"], "ide": p["blue"], "fastMode": p["orange"],
        "diffAdded": tint(p["green"], 0.25), "diffRemoved": tint(p["red"], 0.25),
        "diffAddedDimmed": tint(p["green"], 0.12), "diffRemovedDimmed": tint(p["red"], 0.12),
        "diffAddedWord": tint(p["green"], 0.5), "diffRemovedWord": tint(p["red"], 0.5),
        "userMessageBackground": p["lighter_background"],
        "userMessageBackgroundHover": p["selection"],
        "bashMessageBackgroundColor": p["lighter_background"],
        "memoryBackgroundColor": p["lighter_background"],
        "selectionBg": p["selection"],
        "rate_limit_fill": p["accent"], "rate_limit_empty": p["selection"],
        "red_FOR_SUBAGENTS_ONLY": p["red"], "blue_FOR_SUBAGENTS_ONLY": p["blue"],
        "green_FOR_SUBAGENTS_ONLY": p["green"], "yellow_FOR_SUBAGENTS_ONLY": p["yellow"],
        "purple_FOR_SUBAGENTS_ONLY": p["magenta"], "orange_FOR_SUBAGENTS_ONLY": p["orange"],
        "pink_FOR_SUBAGENTS_ONLY": p["bright_magenta"], "cyan_FOR_SUBAGENTS_ONLY": p["cyan"],
    }
    return json.dumps({"name": f"Desktop ({meta['name']})",
                       "base": "light" if p.get("mode") == "light" else "dark",
                       "overrides": tokens}, indent=2) + "\n"


def nighttab(p, table=CATPPUCCIN_ROLES):
    """Overrides for the nightTab new-tab page (Firefox): its 14 background
    shades and accent colour, as CSS variables. theme-set wraps this for the
    extension's page in the profile's userContent.css. It assumes nightTab's
    style is Dark (shade 1 is the page background); text colours are worked
    out by nightTab from each shade's brightness, so light palettes work.
    The accent is the bar's (Catppuccin lavender's role, so theme.toml's
    [hyprpanel_roles] applies: Osaka Jade's cream)."""
    import colorsys
    bg, fg = p["background"], p["foreground"]
    lines = [f"/* {HEADER} */"]
    for n in range(1, 15):
        r, g, b = rgb(mix(bg, fg, (n - 1) / 13 * 0.6))
        h, l, sat = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        lines += [f"--theme-primary-{n}-r: {r} !important;", f"--theme-primary-{n}-g: {g} !important;",
                  f"--theme-primary-{n}-b: {b} !important;", f"--theme-primary-{n}-h: {round(h * 360)} !important;",
                  f"--theme-primary-{n}-s: {round(sat * 100)} !important;",
                  f"--theme-primary-{n}-l: {round(l * 100)} !important;"]
    roles = dict(p, button=mix(p["background"], p["lighter_background"], 0.4))
    r, g, b = rgb(role_colour(roles, table[CATPPUCCIN_NAMES["lavender"]]))
    dark_text = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 > 0.55
    lines += [f"--theme-accent-rgb-r: {r} !important;", f"--theme-accent-rgb-g: {g} !important;",
              f"--theme-accent-rgb-b: {b} !important;", f"--theme-accent: {r}, {g}, {b} !important;",
              f"--theme-accent-text: 0, 0%, {0 if dark_text else 100}% !important;"]
    return "\n".join(lines) + "\n"


def generate(theme):
    folder = os.path.join(THEMES, theme)
    with open(os.path.join(folder, "theme.toml"), "rb") as f:
        meta = tomllib.load(f)
    if not meta.get("generate"):
        return False
    with open(os.path.join(folder, "colors.toml"), "rb") as f:
        p = tomllib.load(f)
    table = catppuccin_roles(meta)
    if meta.get("hyprpanel") == "generate":
        bar_json = hyprpanel(p, table)
        bar = json.loads(bar_json)
    else:
        with open(f"/usr/share/hyprpanel/themes/{meta['hyprpanel']}.json") as f:
            bar = json.load(f)
    files = {
        "hyprland.lua": hyprland(p), "hyprlock.conf": hyprlock(p), "kitty.conf": kitty(p),
        "rofi.rasi": rofi(p, bar, meta.get("rofi")), "starship.toml": starship(p), "tmux.conf": tmux(p),
        "nvim.lua": nvim(p, meta), "claude.json": claude(p, meta),
        "nighttab.css": nighttab(p, table),
    }
    if meta.get("gtk4") == "generate":
        files["gtk.css"] = gtk4(p)
    if meta.get("fish") == "generate":
        files["fish.theme"] = fish(p)
    if meta.get("hyprpanel") == "generate":
        files["hyprpanel.json"] = bar_json
    path = os.path.join(folder, "obsidian.css")
    if meta.get("obsidian", True):
        files["obsidian.css"] = obsidian(p)
    elif os.path.exists(path):
        os.remove(path)  # e.g. Catppuccin: Obsidian's Catppuccin theme as it is
    icon_map = icons(p, table) if meta.get("icons", True) else None
    path = os.path.join(folder, "icons.json")
    if icon_map:
        files["icons.json"] = icon_map
    elif os.path.exists(path):
        os.remove(path)
    for name, text in files.items():
        with open(os.path.join(folder, name), "w") as f:
            f.write(text)
    return True


def main():
    themes = sys.argv[1:] or sorted(
        d for d in os.listdir(THEMES) if os.path.isfile(os.path.join(THEMES, d, "theme.toml")))
    for theme in themes:
        if generate(theme):
            print(f"generated {theme}")


if __name__ == "__main__":
    main()
