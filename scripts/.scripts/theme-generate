#!/usr/bin/env python3
"""Generate each app's colour file for the themes in ~/.config/themes.

For every theme whose theme.toml has `generate = true`, reads its colors.toml
(Omarchy's palette format) and writes, next to it:
    hyprland.lua  hyprlock.conf  kitty.conf  rofi.rasi  starship.toml
    tmux.conf     gtk.css        fish.theme  nvim.lua    hyprpanel.json
    icons.json
The kitty and Hyprland mappings follow Omarchy's templates
(github.com/omacom/omarchy default/themed/*.tpl, MIT).

Usage: theme-generate [THEME…]   (default: all generated themes)
Run it after editing a theme's colors.toml, then `theme-set <theme>`.
"""
import json
import os
import sys
import tomllib

THEMES = os.path.expanduser("~/.config/themes")
HEADER = "Generated by ~/.scripts/theme-generate from colors.toml; edit that and rerun."


def hexa(c, alpha="ff"):
    return c.lstrip("#").lower() + alpha


def hyprland(p):
    return f"""-- {HEADER}
-- Window borders and the compositor background, applied by ~/.config/hypr/hyprland.lua.
hl.config({{
    general = {{
        col = {{
            active_border   = {{ colors = {{ "rgba({hexa(p['accent'])})", "rgba({hexa(p['selection'])})" }}, angle = 30 }},
            inactive_border = "rgba({hexa(p['lighter_background'])})",
        }},
    }},
    misc = {{ background_color = "rgba({hexa(p['background'])})" }},
}})
"""


def hyprlock(p):
    # Same variable names as the Rosé Pine file hyprlock.conf was written for.
    names = {
        "base": "background", "surface": "lighter_background", "overlay": "selection",
        "muted": "muted", "subtle": "light_foreground", "text": "foreground",
        "love": "red", "gold": "yellow", "rose": "orange", "pine": "green",
        "foam": "blue", "iris": "magenta", "highlightLow": "lighter_background",
        "highlightMed": "selection", "highlightHigh": "muted",
    }
    lines = [f"# {HEADER}"]
    lines += [f"${k:<14} = 0xff{p[v].lstrip('#').lower()}" for k, v in names.items()]
    return "\n".join(lines) + "\n"


def kitty(p):
    return f"""# {HEADER}
foreground               {p['foreground']}
background               {p['background']}
selection_foreground     {p['foreground']}
selection_background     {p['selection']}

